    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>TarkovOverlay.Maps</RootNamespace>
    <AssemblyName>TarkovOverlay.Maps</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TarkovOverlay.Maps.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TarkovOverlay.Core\TarkovOverlay.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Definitions\maps.fallback.json" LogicalName="TarkovOverlay.Maps.maps.fallback.json" />
  </ItemGroup>
</Project>
