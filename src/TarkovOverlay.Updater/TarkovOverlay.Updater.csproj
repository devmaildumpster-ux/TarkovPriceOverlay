<Project Sdk="Microsoft.NET.Sdk">
  <!--
    1.2.8: TarkovPriceOverlay.Updater.exe. The overlay copies it to %LOCALAPPDATA%\TarkovPriceOverlay\update and starts it
    just before exiting; it swaps the files in the install folder (backup + rollback) and relaunches the overlay.
    Published as one self-contained, trimmed, compressed exe (about 10 MB) so it runs without anything installed and
    never locks a file in the install folder. The App project publishes it next to TarkovPriceOverlay.exe.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>TarkovPriceOverlay.Updater</AssemblyName>
    <RootNamespace>TarkovOverlay.Updater</RootNamespace>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\TarkovOverlay.App\app.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TarkovOverlay.Core\TarkovOverlay.Core.csproj" />
  </ItemGroup>
</Project>
